APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8082

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cbta_api_db
DB_USERNAME=root
DB_PASSWORD=

CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file

# Webhook firmado hacia Dr. Sam. Ambos proyectos deben compartir el secreto.
DR_SAM_WEBHOOK_URL=http://127.0.0.1:8000/api/integrations/cbta/mixture-status
DR_SAM_WEBHOOK_SECRET=
DR_SAM_WEBHOOK_TIMEOUT=5
DR_SAM_WEBHOOK_CONNECT_TIMEOUT=3
DR_SAM_WEBHOOK_MAX_ATTEMPTS=8
